{
  "manifest_version": 3,
  "name": "JobTracker - Application Tracker",
  "version": "1.0.1",
  "description": "Track your job applications automatically. Never lose track of where you applied. Sync with your personal dashboard.",
  "author": "Atharva Mutkule",

  "permissions": ["storage", "notifications", "activeTab", "tabs"],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.naukri.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/JOBTRACKER16x16.png",
      "32": "icons/JOBTRACKER32x32.png",
      "48": "icons/JOBTRACKER48x48.png",
      "128": "icons/JOBTRACKER128x128.png"
    }
  },
  "options_page": "dist/settings.html",
  "icons": {
    "16": "icons/JOBTRACKER16x16.png",
    "32": "icons/JOBTRACKER32x32.png",
    "48": "icons/JOBTRACKER48x48.png",
    "128": "icons/JOBTRACKER128x128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "dist/content-linkedin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.naukri.com/*"
      ],
      "js": [
        "dist/content-naukri.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://job-tracker-jwue.vercel.app/*",
      "http://localhost/*"
    ]
  }
}